---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('escrits', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<MainLayout title="Escrits — Moha" description="Assajos, apunts i relats.">
  <section class="page-title"><p class="eyebrow">ARXIU</p><h1>Escrits</h1><p class="lead">Anècdotes, records, costums, llocs i preguntes que no sempre tenen resposta.</p></section>
  <section class="archive-section" aria-label="Llista d'escrits">
    <div class="section-body">
      {posts.length ? <ul class="post-list">{posts.map((post) => <li><div><a href={`/escrits/${post.id}/`}>{post.data.title}</a>{post.data.description && <p class="post-description">{post.data.description}</p>}</div><time>{post.data.date.toLocaleDateString('ca-ES', { day: 'numeric', month: 'short', year: 'numeric' })}</time></li>)}</ul> : <p class="muted">Encara no hi ha cap escrit publicat.</p>}
    </div>
  </section>
</MainLayout>
