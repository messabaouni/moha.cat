---
import MainLayout from '../layouts/MainLayout.astro';
import About from '../components/About.astro';
import { sections, sectionKeys, isFeed, getPublished, byDateDesc, formatDate, excerpt } from '../lib/content';

const actualitzacions = (
  await Promise.all(
    sectionKeys.map(async (ruta) =>
      (await getPublished(ruta)).map((item) => ({
        ...item,
        seccio: sections[ruta].name,
        title: item.data.title ?? excerpt(item.body),
        href: isFeed(ruta) ? `/${ruta}/#${item.id}` : `/${ruta}/${item.id}/`,
      })),
    ),
  )
)
  .flat()
  .sort(byDateDesc)
  .slice(0, 10);
---
<MainLayout title="Moha" description="Dades, lectures i escrits de Moha, a Barcelona.">
  <section class="intro">
    <h1>Hola, sóc en <em>Moha</em>.</h1>
    <p class="lead">M'interessen els llibres, la música, la història, les llengües i les petites coses de la vida quotidiana. 
    Treballo amb dades i tecnologia, però també m'agrada llegir, escriure i aprendre coses noves. 
    Aquest espai recull algunes d'aquestes inquietuds, projectes i pensaments.</p>
  </section>

<About />

  <section class="section">
    <div class="section-heading"><h2>Recentment</h2></div>
    <div class="section-body">
      {actualitzacions.length > 0 ? (
        <ul class="post-list recently-list">
          {actualitzacions.map((item) => <li><a class="recently-title" href={item.href}>{item.title}</a><span>{item.seccio}</span><time>{formatDate(item.data.date)}</time></li>)}
        </ul>
      ) : <p class="muted">Les últimes publicacions apareixeran aquí.</p>}
    </div>
  </section>
</MainLayout>
